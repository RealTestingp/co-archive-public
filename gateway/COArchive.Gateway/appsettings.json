{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "chat-route": {
        "ClusterId": "chat-cluster",
        "Match": {
          "Path": "/api/chat"
        }
      },
      "core-api-route": {
        "ClusterId": "core-api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "reports-route": {
        "ClusterId": "reports-cluster",
        "Match": {
          "Path": "/reports/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "chat-cluster": {
        "Destinations": {
          "chat-primary": {
            "Address": "http://chatbot-service:8080"
          }
        }
      },
      "core-api-cluster": {
        "Destinations": {
          "core-api-primary": {
            "Address": "https://core-api.politeglacier-fb6c27b1.canadacentral.azurecontainerapps.io"
          }
        }
      },
      "reports-cluster": {
        "Destinations": {
          "reports-primary": {
            "Address": "http://reports-service:8080"
          }
        }
      }
    }
  }
}